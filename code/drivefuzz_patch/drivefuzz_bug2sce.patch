+    def normalize_seed_data(self, seed):
+        """
+        Support both the legacy flat seed files and full JSON scenarios.
+
+        Full scenario files may use either:
+        - {"mission": {"map": ..., "spawn": {...}, "destination": {...}}}
+        - {"seed": {"map": ..., "sp_x": ..., "wp_x": ...}}
+        """
+        if "mission" in seed:
+            mission = seed["mission"]
+        elif "seed" in seed:
+            mission = seed["seed"]
+        else:
+            mission = seed
+
+        if "spawn" in mission or "start" in mission:
+            spawn = mission.get("spawn", mission.get("start"))
+            dest = mission.get("destination", mission.get("dest",
+                    mission.get("goal")))
+
+            if spawn is None or dest is None:
+                raise ValueError("JSON mission requires spawn and destination")
+
+            return {
+                "map": mission.get("map", mission.get("town", "Town01")),
+                "sp_x": spawn["x"],
+                "sp_y": spawn["y"],
+                "sp_z": spawn.get("z", 0.0),
+                "pitch": spawn.get("pitch", 0.0),
+                "yaw": spawn.get("yaw", 0.0),
+                "roll": spawn.get("roll", 0.0),
+                "wp_x": dest["x"],
+                "wp_y": dest["y"],
+                "wp_z": dest.get("z", 0.0),
+                "wp_yaw": dest.get("yaw", 0.0),
+            }
+
+        normalized = dict(mission)
+        normalized.setdefault("map", "Town01")
+        normalized.setdefault("pitch", 0.0)
+        normalized.setdefault("yaw", 0.0)
+        normalized.setdefault("roll", 0.0)
+        normalized.setdefault("wp_yaw", 0.0)
+        return normalized
+
+    def load_json_mutators(self, seed):
+        payload = seed.get("mutators", seed)
+
+        weather = payload.get("weather", {})
+        for key in WEATHER_KEYS:
+            if key in weather:
+                self.weather[key] = weather[key]
+
+        self.actors = [
+            self.normalize_actor(actor)
+            for actor in payload.get("actors", [])
+        ]
+        self.puddles = [
+            self.normalize_puddle(puddle)
+            for puddle in payload.get("puddles", [])
+        ]
+
+    def normalize_actor_type(self, value):
+        if isinstance(value, str):
+            return ACTOR_TYPE_BY_NAME[value.lower()]
+        return int(value)
+
+    def normalize_nav_type(self, value):
+        if isinstance(value, str):
+            return NAVTYPE_BY_NAME[value.lower()]
+        return int(value)
+
+    def normalize_location_rotation(self, item, default_z=1.5):
+        if item is None:
+            return None
+
+        if isinstance(item, dict):
+            loc = (
+                item["x"],
+                item["y"],
+                item.get("z", default_z)
+            )
+            rot = (
+                item.get("roll", 0.0),
+                item.get("pitch", 0.0),
+                item.get("yaw", 0.0)
+            )
+            return (loc, rot)
+
+        if isinstance(item, (list, tuple)):
+            if len(item) == 2:
+                return (tuple(item[0]), tuple(item[1]))
+            if len(item) == 3:
+                return (tuple(item), (0.0, 0.0, 0.0))
+
+        raise ValueError("Expected location/rotation as dict or tuple/list")
+
+    def normalize_actor_point(self, actor, prefix, aliases, default_z=1.5):
+        for alias in aliases:
+            if alias in actor:
+                return self.normalize_location_rotation(
+                    actor[alias],
+                    default_z=default_z
+                )
+
+        x_key = prefix + "_x"
+        y_key = prefix + "_y"
+        z_key = prefix + "_z"
+        if x_key in actor and y_key in actor:
+            loc = (
+                actor[x_key],
+                actor[y_key],
+                actor.get(z_key, default_z)
+            )
+            rot = (
+                actor.get(prefix + "_roll", 0.0),
+                actor.get(prefix + "_pitch", 0.0),
+                actor.get(prefix + "_yaw", 0.0)
+            )
+            return (loc, rot)
+
+        idx_key = prefix + "_idx"
+        if idx_key in actor:
+            point = executor.list_spawn_points[int(actor[idx_key])]
+            return (
+                (point.location.x, point.location.y, point.location.z),
+                (point.rotation.roll, point.rotation.pitch, point.rotation.yaw)
+            )
+
+        return None
+
+    def normalize_actor(self, actor):
+        actor_type = self.normalize_actor_type(actor["type"])
+        nav_type = self.normalize_nav_type(actor["nav_type"])
+        spawn_point = self.normalize_actor_point(
+            actor,
+            "sp",
+            ("spawn", "start", "spawn_point"),
+            default_z=1.5
+        )
+        dest_point = self.normalize_actor_point(
+            actor,
+            "dp",
+            ("destination", "dest", "goal", "dest_point"),
+            default_z=1.5
+        )
+
+        if spawn_point is None:
+            raise ValueError("Actor requires a spawn point")
+
+        maneuvers = actor.get("maneuvers")
+        if maneuvers is not None:
+            maneuvers = [list(maneuver) for maneuver in maneuvers]
+
+        return {
+            "type": actor_type,
+            "nav_type": nav_type,
+            "spawn_point": spawn_point,
+            "dest_point": dest_point,
+            "speed": actor.get("speed"),
+            "maneuvers": maneuvers
+        }
+
+    def normalize_puddle_location(self, puddle):
+        for key in ("location", "spawn", "spawn_point"):
+            if key in puddle:
+                return self.normalize_location_rotation(
+                    puddle[key],
+                    default_z=0.0
+                )[0]
+
+        return (
+            puddle["sp_x"],
+            puddle["sp_y"],
+            puddle.get("sp_z", 0.0)
+        )
+
+    def normalize_puddle_size(self, puddle):
+        if "size" in puddle:
+            size = puddle["size"]
+            if isinstance(size, dict):
+                return (
+                    size["x"],
+                    size["y"],
+                    size.get("z", 1000.0)
+                )
+            return tuple(size)
+
+        return (
+            puddle["size_x"],
+            puddle["size_y"],
+            puddle.get("size_z", 1000.0)
+        )
+
+    def normalize_puddle(self, puddle):
+        loc = self.normalize_puddle_location(puddle)
+        size = self.normalize_puddle_size(puddle)
+
+        return {
+            "level": puddle["level"],
+            "size": size,
+            "spawn_point": (loc, (0.0, 0.0, 0.0))
+        }
+
