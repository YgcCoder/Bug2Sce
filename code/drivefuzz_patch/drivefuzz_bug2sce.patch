+def ros_command(name):
+    cmd = shutil.which(name)
+    if cmd:
+        return cmd
+
+    fallback = os.path.join("/opt/ros/melodic/bin", name)
+    if os.path.exists(fallback):
+        return fallback
+
+    return name
+
+
+def ros_setup():
+    setup = os.getenv("DRIVEFUZZ_ROS_SETUP", "/opt/ros/melodic/setup.bash")
+    if os.path.exists(setup):
+        return setup
+    return None
+
+
+def ros_command_args(args):
+    setup = ros_setup()
+    if setup:
+        cmd = " ".join(shlex.quote(str(arg)) for arg in args)
+        return [
+            "bash",
+            "-lc",
+            "source {} && exec {}".format(shlex.quote(setup), cmd)
+        ]
+
+    return [ros_command(args[0])] + list(args[1:])
+
+
+def ros_popen(args, **kwargs):
+    return Popen(ros_command_args(args), **kwargs)
+
+
+def ros_system(args, **kwargs):
+    proc = ros_popen(args, **kwargs)
+    return proc.wait()
+
